@@ -0,0 +1,223 @@
+"""CPU-only regressions for retaining prompt tails past a decode boundary.
+
+Tiny synthetic cache tensors exercise real block hashes, SSD persistence and
+recurrent-state restoration. No model is loaded or run.
+"""
+
+from contextlib import nullcontext
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import mlx.core as mx
+import pytest
+
+import omlx.scheduler as scheduler_module
+from omlx.cache.boundary_snapshot_store import BoundarySnapshotSSDStore
+from omlx.cache.paged_cache import PagedCacheManager
+from omlx.cache.paged_ssd_cache import PagedSSDCacheManager
+from omlx.cache.prefix_cache import BlockAwarePrefixCache
+from omlx.scheduler import Scheduler, _BoundarySnapshotProvider
+
+
+@pytest.fixture(autouse=True)
+def cpu_only(monkeypatch):
+    previous = mx.default_device()
+    mx.set_default_device(mx.cpu)
+    monkeypatch.setattr(scheduler_module, "_safe_sync_stream", lambda _stream: None)
+    yield
+    mx.set_default_device(previous)
+
+
+def extracted(tc, *, placeholder=False):
+    return [
+        {
+            "state": () if placeholder else (
+                mx.full((1, 2, tc, 8), 17.0), mx.full((1, 2, tc, 8), 18.0)
+            ),
+            "class_name": "KVCache", "cache_type": "KVCache", "meta_state": (tc,),
+        },
+        {
+            # A different value at every endpoint catches use of a newer GDN
+            # state disguised as a shorter prefix.
+            "state": (mx.full((1, 3, 8), float(tc)), mx.full((1, 2, 4, 8), float(tc))),
+            "class_name": "ArraysCache", "cache_type": "ArraysCache", "meta_state": (),
+        },
+    ]
+
+
+def scheduler_shell(*, marker=0, public=(), persists=True):
+    scheduler = object.__new__(Scheduler)
+    scheduler.config = SimpleNamespace(paged_cache_block_size=4)
+    scheduler.requests = {"request": SimpleNamespace(
+        generation_prompt_start=marker, generation_prompt_persists=persists,
+        _public_prefix_boundaries=list(public), _model_cache_config=None,
+    )}
+    scheduler._boundary_cache_snapshots = {}
+    scheduler._boundary_snapshot_diagnostics = MagicMock()
+    scheduler._boundary_snapshot_store = None
+    scheduler.paged_ssd_cache_manager = None
+    scheduler._phase_timer = lambda _phase: nullcontext()
+    scheduler._stream = mx.default_stream(mx.cpu)
+    return scheduler
+
+
+def test_main_decode_boundary_keeps_real_prompt_tail_and_pre_eval_ownership():
+    scheduler = scheduler_shell(marker=3)
+    tail, aligned = extracted(3, placeholder=True), extracted(4, placeholder=True)
+    scheduler._boundary_cache_snapshots["request"] = {
+        3: (Scheduler._PREFILL_SNAPSHOT_MARKER, tail),
+        4: (Scheduler._PREFILL_SNAPSHOT_MARKER, aligned),
+    }
+    tokens, cache, _, provider = scheduler._get_boundary_store_override("request", list(range(6)))
+    assert tokens == list(range(4)) and cache is aligned
+    assert provider.tail_terminal_token_count is None
+    assert provider.auxiliary_tails == {3: tail}
+    assert list(provider.iter_in_memory_extracted()) == [tail]
+    assert 3 not in provider  # A sibling tail is not a block of the main chain.
+    assert provider.for_auxiliary_tail(3).tail_terminal_token_count == 3
+
+
+def test_tail_limit_prioritizes_prompt_and_public_boundaries():
+    scheduler = scheduler_shell(marker=7, public=(1, 3))
+    scheduler._boundary_cache_snapshots["request"] = {
+        tc: (Scheduler._PREFILL_SNAPSHOT_MARKER, extracted(tc, placeholder=True))
+        for tc in (1, 3, 4, 5, 7, 8)
+    }
+    _, _, _, provider = scheduler._get_boundary_store_override("request", list(range(10)))
+    assert list(provider.auxiliary_tails) == [7, 1, 3]
+    assert len(provider.auxiliary_tails) == 3
+
+
+def test_existing_terminal_tail_is_not_saved_twice_or_replaced_by_decode():
+    scheduler = scheduler_shell(marker=7, public=(1, 3), persists=False)
+    scheduler._boundary_cache_snapshots["request"] = {
+        tc: (Scheduler._PREFILL_SNAPSHOT_MARKER, extracted(tc, placeholder=True))
+        for tc in (1, 3, 4, 7, 8)
+    }
+    tokens, _, _, provider = scheduler._get_boundary_store_override("request", list(range(10)))
+    assert len(tokens) == 7
+    assert provider.tail_terminal_token_count == 7
+    assert set(provider.auxiliary_tails) == {1, 3}
+    assert len(provider.auxiliary_tails) + 1 == 3
+
+
+def test_missing_tail_snapshot_cannot_be_fabricated_from_later_state():
+    scheduler = scheduler_shell(marker=3)
+    scheduler._boundary_cache_snapshots["request"] = {
+        3: None, 4: (Scheduler._PREFILL_SNAPSHOT_MARKER, extracted(4, placeholder=True)),
+    }
+    tokens, _, _, provider = scheduler._get_boundary_store_override("request", list(range(6)))
+    assert len(tokens) == 4
+    assert provider.auxiliary_tails == {}
+
+
+@pytest.fixture
+def real_cache(tmp_path):
+    paged = PagedCacheManager(block_size=4, max_blocks=100, initial_blocks=100, model_name="hybrid")
+    ssd = PagedSSDCacheManager(
+        cache_dir=tmp_path, max_size_bytes=100 * 1024**2,
+        expected_model_name="hybrid", expected_num_layers=2,
+        expected_block_size=4, expected_layer_cache_types=["KVCache", "ArraysCache"],
+        gdn_ssd_split_enabled=True, gdn_sidecar_state_dtype="fp32",
+    )
+    boundary = BoundarySnapshotSSDStore(tmp_path, pending_max_bytes=1024**2, gdn_sidecar_state_dtype="fp32")
+    prefix = BlockAwarePrefixCache(
+        model=MagicMock(), paged_cache_manager=paged, paged_ssd_cache_manager=ssd,
+        gdn_ssd_split_enabled=True,
+    )
+    prefix.set_gdn_checkpoint_loader(boundary.load_file)
+    scheduler = scheduler_shell(marker=11, public=(3, 7))
+    scheduler._boundary_snapshot_store = boundary
+    scheduler.paged_ssd_cache_manager = ssd
+    scheduler.paged_cache_manager = paged
+    scheduler.block_aware_cache = prefix
+    try:
+        yield scheduler, prefix, paged, boundary
+    finally:
+        boundary.shutdown()
+        ssd.close()
+
+
+def store_request(scheduler, request_id):
+    scheduler.requests[request_id] = scheduler.requests["request"]
+    snapshots = {}
+    for tc in (3, 4, 7, 8, 11, 12):
+        state = extracted(tc, placeholder=True)
+        assert scheduler._boundary_snapshot_store.save(
+            request_id, tc, state, lambda x: (x, None), block_size=4,
+        )
+        snapshots[tc] = None
+    scheduler._boundary_cache_snapshots[request_id] = snapshots
+    tokens, state, config, provider = scheduler._get_boundary_store_override(request_id, list(range(14)))
+    assert len(tokens) == 12 and set(provider.auxiliary_tails) == {3, 7, 11}
+    payload = Scheduler._merge_boundary_with_full_cache(state, extracted(14))
+    for values in [payload, *provider.iter_in_memory_extracted()]:
+        mx.eval(*Scheduler._collect_arrays_from_extracted_cache(values))
+    scheduler._async_store_cache_worker(request_id, tokens, payload, config, provider, None, None, None)
+    # Production runs this after the future finishes. Hits must now depend on
+    # durable sidecars, not the temporary snapshot staging files.
+    scheduler._boundary_snapshot_store.cleanup_request(request_id)
+
+
+def assert_restored(prefix, paged, tc):
+    rid = f"read-{tc}"
+    table, remaining = prefix.fetch_cache(rid, list(range(tc)) + [999])
+    assert table is not None and table.num_tokens == tc
+    assert remaining == [999]
+    restored = prefix.reconstruct_cache(table)
+    assert restored is not None
+    assert restored[0].keys_and_values()[0].shape[2] == tc
+    assert float(restored[1].cache[0][0, 0, 0]) == float(tc)
+    assert float(restored[1].cache[1][0, 0, 0, 0]) == float(tc)
+    with paged._lock:
+        paged.request_tables.pop(rid)
+        paged.release_for_eviction(table.block_ids)
+    prefix.clear_request_entry(rid)
+
+
+def test_real_ssd_keeps_main_and_three_tail_branches_after_cleanup_and_dedup(real_cache):
+    scheduler, prefix, paged, _ = real_cache
+    scheduler._on_auxiliary_tail_stored = MagicMock()
+    store_request(scheduler, "request")
+    assert scheduler._on_auxiliary_tail_stored.call_count == 3
+    assert sum(not block.is_null for block in paged.allocated_blocks.values()) == 6  # Three full blocks, three distinct tails.
+    assert all(block.ref_count == 0 for block in paged.allocated_blocks.values() if not block.is_null)
+    assert not any(":prefix-tail:" in rid for rid in paged.request_tables)
+    assert not prefix._request_tables
+    for tc in (3, 7, 11, 12):
+        assert_restored(prefix, paged, tc)
+
+    store_request(scheduler, "repeated")
+    assert sum(not block.is_null for block in paged.allocated_blocks.values()) == 6  # Repeat does not duplicate branches.
+    assert all(block.ref_count == 0 for block in paged.allocated_blocks.values() if not block.is_null)
+    for tc in (3, 7, 11, 12):
+        assert_restored(prefix, paged, tc)
+
+
+def test_partial_tail_failure_releases_refs_and_other_tails_survive(real_cache, monkeypatch):
+    scheduler, prefix, paged, _ = real_cache
+    original = prefix.store_cache
+
+    def failing(request_id, *args, **kwargs):
+        result = original(request_id, *args, **kwargs)
+        if request_id.endswith(":prefix-tail:3"):
+            raise RuntimeError("after table acquired refs")
+        return result
+
+    monkeypatch.setattr(prefix, "store_cache", failing)
+    store_request(scheduler, "request")
+    assert not any(":prefix-tail:" in rid for rid in paged.request_tables)
+    assert not prefix._request_tables
+    assert all(block.ref_count == 0 for block in paged.allocated_blocks.values() if not block.is_null)
+    for tc in (7, 11, 12):
+        assert_restored(prefix, paged, tc)
+
+
+def test_notification_failure_does_not_break_storage_or_cleanup(real_cache):
+    scheduler, prefix, paged, _ = real_cache
+    scheduler._on_auxiliary_tail_stored = MagicMock(side_effect=RuntimeError("observer failure"))
+    store_request(scheduler, "request")
+    assert scheduler._on_auxiliary_tail_stored.call_count == 3
+    assert all(block.ref_count == 0 for block in paged.allocated_blocks.values() if not block.is_null)
+    for tc in (3, 7, 11, 12):
+        assert_restored(prefix, paged, tc)
