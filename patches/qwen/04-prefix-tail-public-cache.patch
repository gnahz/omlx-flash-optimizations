+"""Qwen public-prefix admission and owner-thread integration helpers."""
+from __future__ import annotations
+import logging
+import os
+from .public_prefix import PublicPrefixPolicy, initial_message_boundaries
+from .paged_cache import compute_block_hash
+
+logger = logging.getLogger(__name__)
+
+
+def _sidecars(ssd, block_hash):
+    return [m for m in ssd._gdn_sidecar_index.get_all_metadata()
+            if m.source_block_hash == block_hash]
+
+
+def _stored_bytes(scheduler, entry):
+    ssd = scheduler.paged_ssd_cache_manager
+    if ssd is None or entry.block_hash is None:
+        return 0
+    meta = ssd.get_block_metadata(entry.block_hash)
+    return (meta.file_size if meta else 0) + sum(m.file_size for m in _sidecars(ssd, entry.block_hash))
+
+
+def _evict(scheduler, entry):
+    """Delete only a quiescent, unreferenced terminal public branch."""
+    paged, ssd = scheduler.paged_cache_manager, scheduler.paged_ssd_cache_manager
+    if entry.block_hash is None:
+        # A reservation may still be owned by a prefill/store in flight.
+        return False
+    bh = entry.block_hash
+    with paged._lock:
+        value = paged.cached_block_hash_to_block._cache.get(bh)
+        blocks = list(value.values()) if isinstance(value, dict) else ([value] if value else [])
+        if any(block.ref_count for block in blocks):
+            return False
+        # Match the writer's SSD lock -> pending-buffer lock order. A writer
+        # cannot replace a sidecar between its metadata read and unlink here.
+        with ssd._lock:
+            with ssd._pending_write_hashes_lock:
+                if bh in ssd._pending_write_hashes:
+                    return False
+            for meta in _sidecars(ssd, bh):
+                try:
+                    removed = ssd._unlink_gdn_sidecar_file(meta)
+                except OSError as exc:
+                    logger.warning("Public prefix sidecar eviction deferred: %s", exc)
+                    return False
+                if not removed:
+                    return False
+                ssd._gdn_sidecar_index.remove_key(meta.key)
+            meta = ssd.get_block_metadata(bh)
+            if meta is not None and not ssd.delete_block(bh):
+                # delete_block removes accounting before unlink. Preserve the
+                # reservation/index when that unlink failed, for a safe retry.
+                ssd._index.add(meta)
+                return False
+        for block in blocks:
+            paged.cached_block_hash_to_block.pop(bh, block.block_id)
+            block.reset_hash()
+        paged._notify_hash_dropped(bh)
+        paged.forget_tail_block(bh)
+        logger.info("Public prefix evicted: tokens=%d hits=%d/%d", entry.length,
+                    entry.direct_hits, entry.opportunities)
+        return True
+
+
+def _branch_hash(scheduler, tokens, end):
+    parent = None
+    block = scheduler.config.paged_cache_block_size
+    for start in range(0, end, block):
+        parent = compute_block_hash(parent, tokens[start:min(start+block,end)],
+                                    model_name=scheduler.paged_cache_manager.model_name)
+    return parent
+
+
+def admit(scheduler, request):
+    if os.getenv("OMLX_PREFIX_PUBLIC_BOUNDARIES", "0") != "1":
+        return
+    # Text-only Qwen ChatML. Multimodal/external extra-key domains continue to
+    # use ordinary cache paths; this policy's local identities omit those keys.
+    if (request.specprefill_indices is not None or request.vlm_extra_keys_for_cache
+            or request.vlm_extra_key_ranges_for_cache or scheduler.block_aware_cache is None):
+        return
+    if not str(getattr(scheduler.model,"model_type","")).startswith("qwen4_exp"):
+        return
+    policy = getattr(scheduler, "_public_prefix_policy", None)
+    if policy is None:
+        policy = PublicPrefixPolicy(scheduler.config.paged_cache_block_size,
+            evict=lambda e: _evict(scheduler,e), size=lambda e: _stored_bytes(scheduler,e))
+        scheduler._public_prefix_policy = policy
+    tokens = request.prompt_token_ids
+    boundaries = initial_message_boundaries(tokens, scheduler.tokenizer)
+    admitted = policy.observe(tokens,boundaries,request.cached_tokens)
+    request._public_prefix_boundaries = admitted
+    for end in admitted:
+        bh = _branch_hash(scheduler,tokens,end)
+        if scheduler.paged_ssd_cache_manager.has_block(bh):
+            policy.bind(tokens[:end],bh)
+    if boundaries:
+        logger.info("Public prefix policy: request=%s candidates=%s admitted=%s cached=%d stats=%s",
+                    request.request_id,boundaries,admitted,request.cached_tokens,policy.stats())
+
+
+def stored(scheduler, tokens, block_table):
+    policy = getattr(scheduler,"_public_prefix_policy",None)
+    if policy is None or not block_table.block_ids:
+        return
+    block = scheduler.paged_cache_manager.blocks[block_table.block_ids[-1]]
+    policy.bind(tokens,block.block_hash)
+
+
+def clamp(request, position, count):
+    for end in getattr(request,"_public_prefix_boundaries",[]):
+        if position < end < position+count:
+            count = end-position
+    return count
+
+
+def capture(scheduler, request, cache, position):
+    if position in getattr(request,"_public_prefix_boundaries",[]):
+        scheduler._emit_prefill_tail_snapshot(request,cache,position)
+        logger.info("Public prefix snapshot: request=%s tokens=%d",request.request_id,position)
