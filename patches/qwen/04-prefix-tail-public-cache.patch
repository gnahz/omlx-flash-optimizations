+from omlx.cache.public_prefix import PublicPrefixPolicy, initial_message_boundaries
+
+
+class Tokenizer:
+    def encode(self, text, **kwargs):
+        return {"<|im_start|>": [1], "<|im_end|>": [2],
+                "<|im_start|>system\n": [1,3,4],
+                "<|im_start|>developer\n": [1,5,4]}[text]
+
+
+def test_initial_system_tools_boundary_uses_actual_tokens():
+    tokens = [1,3,4]+[42]*300+[2,4]+[1,7,4,99]
+    assert initial_message_boundaries(tokens, Tokenizer()) == [305]
+    assert initial_message_boundaries([1,7,4]+tokens, Tokenizer()) == []
+
+
+def test_two_initial_messages_and_fail_closed():
+    tokens = [1,3,4]+[42]*300+[2,4]+[1,5,4]+[17]*300+[2,4]+[1,7,4,99]
+    assert initial_message_boundaries(tokens, Tokenizer()) == [305,610]
+    assert initial_message_boundaries([1,3,4]+[42]*300+[1,7,4], Tokenizer()) == []
+
+
+def test_public_prefix_needs_repetition_and_counts_hits():
+    p=PublicPrefixPolicy(8192)
+    a=[9]*2048+[1]; b=[9]*2048+[2]
+    assert p.observe(a,[2048],0)==[]
+    assert p.observe(b,[2048],0)==[2048]
+    assert p.observe(a,[2048],2048)==[2048]
+    assert p.stats()['direct_hits']==1
+
+
+def test_capacity_evicts_low_hit_rate_and_keeps_hot_entry():
+    evicted=[]
+    p=PublicPrefixPolicy(8192,max_active=2,evict=lambda e: evicted.append(e.length) or True)
+    for a,n in [([1]*5000,2048),([2]*5000,3072)]:
+        p.observe(a,[n],0);p.observe(a,[n],0)
+    p.observe([1]*5000,[2048],2048)
+    p.observe([3]*5000,[4096],0);p.observe([3]*5000,[4096],0)
+    assert evicted==[3072]
+    assert p.stats()['active']==2
+
+
+def test_busy_victim_prevents_over_admission():
+    p=PublicPrefixPolicy(8192,max_active=1,evict=lambda e:False)
+    for _ in range(2):p.observe([1]*5000,[2048],0)
+    for _ in range(2):result=p.observe([2]*5000,[3072],0)
+    assert result==[]
+    assert p.stats()['active']==1
+
+
+def test_one_off_candidates_are_bounded_and_aligned_points_are_free():
+    p=PublicPrefixPolicy(4096,max_candidates=4)
+    for i in range(20):p.observe([i]*5000,[2048,4096],0)
+    assert p.stats()['candidates']==4
+    assert p.stats()['active']==0
+
+
+def test_oversize_candidate_is_not_admitted():
+    p=PublicPrefixPolicy(8192,max_bytes=1024)
+    for _ in range(2):assert p.observe([1]*5000,[2048],0)==[]
+    assert p.stats()['reserved_bytes']==0
+
+
+def test_public_clamp_never_rewinds_or_skips_an_endpoint():
+    from types import SimpleNamespace
+    from omlx.cache.public_prefix_runtime import clamp
+    request=SimpleNamespace(_public_prefix_boundaries=[2048,3072])
+    assert clamp(request,0,8192)==2048
+    assert clamp(request,2048,6144)==1024
+    assert clamp(request,3072,4096)==4096
+    assert clamp(request,0,512)==512
