@@ -0,0 +1,362 @@
+"""CPU-only regressions for tail LRU metadata and public hit-rate admission.
+
+Run directly with Python, or pytest --noconftest. Private package imports bypass
+omlx.cache's inference imports; these tests never materialize model/GPU data.
+"""
+import importlib.util
+from collections import OrderedDict
+from pathlib import Path
+import sys
+from types import ModuleType, SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+
+def _load_cpu_module(filename):
+    directory = Path(__file__).resolve().parents[1] / "omlx" / "cache"
+    package_name = "_tail_admission_cpu"
+    if package_name not in sys.modules:
+        package = ModuleType(package_name)
+        package.__path__ = [str(directory)]
+        sys.modules[package_name] = package
+    name = package_name + "." + filename
+    spec = importlib.util.spec_from_file_location(name, directory / (filename + ".py"))
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+pc = _load_cpu_module("paged_cache")
+public = _load_cpu_module("public_prefix")
+
+
+class TailAdmissionTests(unittest.TestCase):
+    def manager(self, **kwargs):
+        options = dict(block_size=16, max_blocks=64, initial_blocks=64,
+                       model_name="tail-cpu")
+        options.update(kwargs)
+        return pc.PagedCacheManager(**options)
+
+    def tail(self, manager, tokens, parent=None, *, materialized=True, refs=0,
+             extra_keys=None):
+        digest = pc.compute_block_hash(parent, tokens, extra_keys=extra_keys,
+                                       model_name=manager.model_name)
+        block = None
+        if materialized:
+            block = manager.allocate_block()
+            self.assertIsNotNone(block)
+            block.block_hash = digest
+            block.token_count = len(tokens)
+            block.ref_count = refs
+            manager.cached_block_hash_to_block.insert(digest, block)
+        manager.register_tail_block(parent, digest, len(tokens))
+        return digest, block
+
+    def match(self, manager, tokens, parent=None, start=0, **kwargs):
+        with manager._lock:
+            return manager._match_tail_block(tokens, parent, start, **kwargs)
+
+    def recency(self, manager):
+        return ([*manager._tail_parent_recency],
+                {parent: [*tails] for parent, tails in manager._tail_index.items()})
+
+    def assert_bounded_metadata(self, manager):
+        self.assertEqual(set(manager._tail_index), set(manager._tail_parent_recency))
+        self.assertIsInstance(manager._tail_parent_recency, OrderedDict)
+        self.assertFalse(hasattr(manager, "_tail_hits"))
+        self.assertLessEqual(len(manager._tail_index), pc._TAIL_INDEX_MAX_PARENTS)
+        for tails in manager._tail_index.values():
+            self.assertIsInstance(tails, OrderedDict)
+            self.assertLessEqual(len(tails), pc._TAIL_INDEX_PER_PARENT)
+
+    def test_default_limits_and_frequency_metadata_removed(self):
+        self.assertEqual(pc._TAIL_INDEX_PER_PARENT, 32)
+        self.assertEqual(pc._TAIL_INDEX_MAX_PARENTS, 4096)
+        self.assertFalse(hasattr(pc, "_TAIL_INDEX_HIT_MAX"))
+        self.assert_bounded_metadata(self.manager())
+
+    def test_eight_often_matched_old_and_eight_new_batch_tails_all_remain_matchable(self):
+        manager = self.manager()
+        old = []
+        for i in range(8):
+            digest, block = self.tail(manager, [i, 100])
+            old.append((digest, block))
+            for _ in range(40):
+                self.assertIs(self.match(manager, [i, 100, 999]), block)
+        new = [self.tail(manager, [i, 200]) for i in range(8)]
+        self.assertEqual(len(manager._tail_index[None]), 16)
+        for i, (digest, block) in enumerate(new):
+            self.assertIn(digest, manager._tail_index[None])
+            self.assertIs(self.match(manager, [i, 200, 999]), block)
+        for i, (digest, block) in enumerate(old):
+            self.assertIn(digest, manager._tail_index[None])
+            self.assertIs(self.match(manager, [i, 100, 999]), block)
+        self.assert_bounded_metadata(manager)
+
+    def test_thirty_third_tail_evicts_oldest_even_after_many_previous_hits(self):
+        manager = self.manager()
+        oldest, old_block = self.tail(manager, [0])
+        for _ in range(70):
+            self.assertIs(self.match(manager, [0, 99]), old_block)
+        others = [self.tail(manager, [i])[0] for i in range(1, 32)]
+        newest, newest_block = self.tail(manager, [32])
+        self.assertEqual(list(manager._tail_index[None]), others + [newest])
+        self.assertNotIn(oldest, manager._tail_index[None])
+        self.assertIsNone(self.match(manager, [0, 99]))
+        self.assertIs(self.match(manager, [32, 99]), newest_block)
+        self.assert_bounded_metadata(manager)
+
+    def test_reregistering_tail_refreshes_tail_and_parent_without_duplicate(self):
+        manager = self.manager()
+        digests = [self.tail(manager, [i], b"a")[0] for i in range(32)]
+        self.tail(manager, [99], b"b")
+        manager.register_tail_block(b"a", digests[0], 1)
+        self.assertEqual(list(manager._tail_index[b"a"]), digests[1:] + digests[:1])
+        self.assertEqual(list(manager._tail_parent_recency), [b"b", b"a"])
+        manager.register_tail_block(b"a", b"incoming", 2)
+        self.assertNotIn(digests[1], manager._tail_index[b"a"])
+        self.assertIn(digests[0], manager._tail_index[b"a"])
+        self.assertEqual(len(manager._tail_index[b"a"]), 32)
+        self.assert_bounded_metadata(manager)
+
+    def test_successful_match_refreshes_tail_and_parent(self):
+        manager = self.manager()
+        with patch.object(pc, "_TAIL_INDEX_MAX_PARENTS", 2):
+            with patch.object(pc, "_TAIL_INDEX_PER_PARENT", 2):
+                first, block = self.tail(manager, [1], b"a")
+                second, _ = self.tail(manager, [2], b"a")
+                self.tail(manager, [3], b"b")
+                self.assertIs(self.match(manager, [1, 9], b"a"), block)
+                self.assertEqual(list(manager._tail_index[b"a"]), [second, first])
+                self.assertEqual(list(manager._tail_parent_recency), [b"b", b"a"])
+                self.tail(manager, [4], b"a")
+                self.assertNotIn(second, manager._tail_index[b"a"])
+                self.tail(manager, [5], b"c")
+                self.assertEqual(set(manager._tail_index), {b"a", b"c"})
+                self.assert_bounded_metadata(manager)
+
+    def test_new_tail_registration_refreshes_existing_parent(self):
+        manager = self.manager()
+        with patch.object(pc, "_TAIL_INDEX_MAX_PARENTS", 2):
+            self.tail(manager, [1], b"a")
+            self.tail(manager, [2], b"b")
+            self.tail(manager, [3], b"a")
+            self.assertEqual(list(manager._tail_parent_recency), [b"b", b"a"])
+            self.tail(manager, [4], b"c")
+            self.assertEqual(set(manager._tail_index), {b"a", b"c"})
+
+    def test_parent_lru_drops_old_frequently_matched_parent(self):
+        manager = self.manager()
+        with patch.object(pc, "_TAIL_INDEX_MAX_PARENTS", 3):
+            digest, block = self.tail(manager, [1], b"old-hot", refs=4)
+            for _ in range(60):
+                self.assertIs(self.match(manager, [1, 9], b"old-hot"), block)
+            self.tail(manager, [2], b"new-a")
+            self.tail(manager, [3], b"new-b")
+            self.tail(manager, [4], b"incoming")
+            self.assertEqual(list(manager._tail_parent_recency), [b"new-a", b"new-b", b"incoming"])
+            self.assertNotIn(b"old-hot", manager._tail_index)
+            self.assertEqual(block.ref_count, 4)
+            self.assertIs(manager.cached_block_hash_to_block.get_block(digest), block)
+            self.assert_bounded_metadata(manager)
+
+    def test_parent_registration_refreshes_without_frequency(self):
+        manager = self.manager()
+        with patch.object(pc, "_TAIL_INDEX_MAX_PARENTS", 2):
+            digest, _ = self.tail(manager, [1], b"a")
+            self.tail(manager, [2], b"b")
+            manager.register_tail_block(b"a", digest, 1)
+            self.tail(manager, [3], b"c")
+            self.assertEqual(list(manager._tail_parent_recency), [b"a", b"c"])
+
+    def test_nonmatch_short_input_and_wrong_extra_keys_do_not_refresh(self):
+        manager = self.manager()
+        self.tail(manager, [1, 2, 3], b"a")
+        self.tail(manager, [7], b"a")
+        self.tail(manager, [8], b"b")
+        before = self.recency(manager)
+        for tokens, kwargs in [([1, 2, 9], {}), ([1, 2], {}),
+                               ([1, 2, 3], {"extra_keys": ("wrong",)})]:
+            with self.subTest(tokens=tokens, kwargs=kwargs):
+                self.assertIsNone(self.match(manager, tokens, b"a", **kwargs))
+                self.assertEqual(self.recency(manager), before)
+
+    def test_invalid_registration_does_not_refresh_or_admit(self):
+        manager = self.manager()
+        digest, _ = self.tail(manager, [1], b"a")
+        self.tail(manager, [2], b"b")
+        before = self.recency(manager)
+        for count in (0, -1):
+            manager.register_tail_block(b"a", digest, count)
+            manager.register_tail_block(b"new", b"invalid", count)
+            self.assertEqual(self.recency(manager), before)
+
+    def test_allocation_failure_does_not_refresh_tail_or_parent(self):
+        manager = self.manager(max_blocks=1, initial_blocks=1)
+        digest, _ = self.tail(manager, [1, 2], b"a", materialized=False)
+        self.tail(manager, [7], b"a", materialized=False)
+        self.tail(manager, [8], b"b", materialized=False)
+        manager._paged_ssd_cache_manager = SimpleNamespace(has_block=lambda key: key == digest)
+        before = self.recency(manager)
+        self.assertIsNone(self.match(manager, [1, 2, 9], b"a"))
+        self.assertEqual(self.recency(manager), before)
+        self.assertIsNone(manager.cached_block_hash_to_block.get_block(digest))
+
+    def test_ssd_metadata_restore_refreshes_only_verified_match(self):
+        manager = self.manager()
+        digest, _ = self.tail(manager, [1, 2], b"a", materialized=False)
+        sibling, _ = self.tail(manager, [7], b"a")
+        self.tail(manager, [8], b"b")
+        manager._paged_ssd_cache_manager = SimpleNamespace(has_block=lambda key: key == digest)
+        block = self.match(manager, [1, 2, 9], b"a")
+        self.assertEqual(block.block_hash, digest)
+        self.assertEqual(block.token_count, 2)
+        self.assertEqual(block.ref_count, 0)
+        self.assertEqual(list(manager._tail_index[b"a"]), [sibling, digest])
+        self.assertEqual(list(manager._tail_parent_recency), [b"b", b"a"])
+
+    def test_metadata_eviction_never_releases_block_or_changes_hash_storage(self):
+        manager = self.manager()
+        digest, block = self.tail(manager, [1], refs=3)
+        before = (manager.free_block_queue.num_free_blocks, dict(manager.allocated_blocks),
+                  manager.stats.allocated_blocks)
+        for i in range(32):
+            manager.register_tail_block(None, (i + 100).to_bytes(32, "little"), 2)
+        self.assertNotIn(digest, manager._tail_index[None])
+        self.assertEqual(block.ref_count, 3)
+        self.assertEqual(block.block_hash, digest)
+        self.assertIs(manager.cached_block_hash_to_block.get_block(digest), block)
+        self.assertEqual((manager.free_block_queue.num_free_blocks, dict(manager.allocated_blocks),
+                          manager.stats.allocated_blocks), before)
+
+    def test_longest_prefix_wins_over_short_tail_recency(self):
+        manager = self.manager()
+        short, short_block = self.tail(manager, [1, 2])
+        long, long_block = self.tail(manager, [1, 2, 3])
+        for _ in range(30):
+            self.assertIs(self.match(manager, [1, 2, 9]), short_block)
+        self.assertEqual(list(manager._tail_index[None]), [long, short])
+        self.assertIs(self.match(manager, [1, 2, 3, 9]), long_block)
+        self.assertEqual(list(manager._tail_index[None]), [short, long])
+
+    def test_hash_layout_matches_existing_fixed_vectors(self):
+        self.assertEqual(pc.compute_block_hash(None, [1, 2, 3], model_name="tail-cpu").hex(),
+                         "7ba8ab6831fe8a675752019d8a9e9b147b45558a5c1c871eaec7e36bd4f52559")
+        self.assertEqual(pc.compute_block_hash(b"parent-a", [1, 2, 3],
+                         extra_keys=("image-1",), model_name="tail-cpu").hex(),
+                         "7e4fc871a91a64e455e6bec420c1026b4cbba480817a6d6511f1928c8aea0275")
+
+    def test_nonzero_start_parent_and_segmented_extra_key_domain_remain_exact(self):
+        manager = self.manager()
+        _, block = self.tail(manager, [1, 2, 3], b"parent-a", extra_keys=("image-1",))
+        tokens = [99] * 16 + [1, 2, 3, 8]
+        self.assertIs(self.match(manager, tokens, b"parent-a", 16,
+                      extra_keys=("image-1",), extra_key_token_start=17), block)
+        self.assertIs(self.match(manager, tokens, b"parent-a", 16,
+                      extra_keys=("ignored",), extra_key_ranges=[(17, ("image-1",))]), block)
+        for kwargs in ({"extra_keys": ("image-2",)},
+                       {"extra_keys": ("image-1",), "extra_key_token_start": 19},
+                       {"extra_key_ranges": [(17, ("image-2",))]}):
+            self.assertIsNone(self.match(manager, tokens, b"parent-a", 16, **kwargs))
+        self.assertIsNone(self.match(manager, tokens, b"other-parent", 16))
+
+    def test_stale_last_tail_removes_parent_metadata(self):
+        manager = self.manager()
+        self.tail(manager, [1, 2], b"stale", materialized=False)
+        self.assertIsNone(self.match(manager, [1, 2, 9], b"stale"))
+        self.assertEqual(manager._tail_index, {})
+        self.assertEqual(manager._tail_parent_recency, {})
+        self.assert_bounded_metadata(manager)
+
+    def test_stale_long_tail_removal_retains_and_matches_live_short_sibling(self):
+        manager = self.manager()
+        stale, _ = self.tail(manager, [1, 2, 3], materialized=False)
+        live, block = self.tail(manager, [1, 2])
+        self.assertIs(self.match(manager, [1, 2, 3, 9]), block)
+        self.assertNotIn(stale, manager._tail_index[None])
+        self.assertEqual(list(manager._tail_index[None]), [live])
+        self.assert_bounded_metadata(manager)
+
+    def test_forget_cleans_metadata_without_releasing_active_blocks(self):
+        manager = self.manager()
+        digest, block = self.tail(manager, [1], refs=5)
+        sibling, _ = self.tail(manager, [2])
+        before = (manager.free_block_queue.num_free_blocks, dict(manager.allocated_blocks))
+        self.assertEqual(manager.forget_tail_block(digest), 1)
+        self.assertEqual(manager.forget_tail_block(digest), 0)
+        self.assertNotIn(digest, manager._tail_index[None])
+        self.assertIn(sibling, manager._tail_index[None])
+        self.assertEqual(block.ref_count, 5)
+        self.assertIs(manager.cached_block_hash_to_block.get_block(digest), block)
+        self.assertEqual((manager.free_block_queue.num_free_blocks, dict(manager.allocated_blocks)), before)
+        self.assertEqual(manager.forget_tail_block(sibling), 1)
+        self.assertEqual(manager._tail_index, {})
+        self.assertEqual(manager._tail_parent_recency, {})
+
+    def test_forget_removes_duplicate_hint_from_all_parents(self):
+        manager = self.manager()
+        for parent in (None, b"parent-a", b"parent-b"):
+            manager.register_tail_block(parent, b"same-hint", 2)
+        self.assertEqual(manager.forget_tail_block(b"same-hint"), 3)
+        self.assertEqual(manager._tail_index, {})
+        self.assertEqual(manager._tail_parent_recency, {})
+
+    def test_seed_stress_bounds_both_lru_levels_and_clear_resets_them(self):
+        manager = self.manager()
+        with patch.object(pc, "_TAIL_INDEX_MAX_PARENTS", 3):
+            with patch.object(pc, "_TAIL_INDEX_PER_PARENT", 2):
+                records = [(i.to_bytes(32, "little"), j.to_bytes(32, "little"), 1)
+                           for i in range(20) for j in range(10)]
+                self.assertEqual(manager.seed_tail_blocks(records), 200)
+                self.assertEqual(list(manager._tail_parent_recency),
+                                 [i.to_bytes(32, "little") for i in range(17, 20)])
+                self.assert_bounded_metadata(manager)
+                for tails in manager._tail_index.values():
+                    self.assertEqual(list(tails), [i.to_bytes(32, "little") for i in (8, 9)])
+                manager.clear()
+                self.assertEqual(manager._tail_index, {})
+                self.assertEqual(manager._tail_parent_recency, {})
+                self.assert_bounded_metadata(manager)
+
+
+class PublicPolicyRegressionTests(unittest.TestCase):
+    def test_public_default_remains_two_gib_and_two_observation_admission(self):
+        policy = public.PublicPrefixPolicy(8192)
+        self.assertEqual(policy.max_bytes, 2 * 1024 ** 3)
+        self.assertEqual(policy.stats()["max_bytes"], 2 * 1024 ** 3)
+        tokens = [9] * 2048 + [1]
+        self.assertEqual(policy.observe(tokens, [2048], 0), [])
+        self.assertEqual(policy.observe(tokens, [2048], 0), [2048])
+        self.assertLessEqual(policy.stats()["reserved_bytes"], policy.max_bytes)
+
+    def test_public_eviction_still_uses_hit_rate_before_recency(self):
+        evicted = []
+        policy = public.PublicPrefixPolicy(8192, max_active=2,
+                                          evict=lambda entry: evicted.append(entry.length) or True)
+        hot, cold, incoming = [1] * 5000, [2] * 5000, [3] * 5000
+        for _ in range(2):
+            policy.observe(hot, [2048], 0)
+        for _ in range(30):
+            policy.observe(hot, [2048], 2048)
+        for _ in range(2):
+            policy.observe(cold, [3072], 0)
+        # The hot public entry is older than the cold entry, so a pure LRU would
+        # evict hot. Public policy must still evict the newer zero-hit entry.
+        hot_entry = policy.entries[public.prefix_key(hot, 2048)]
+        cold_entry = policy.entries[public.prefix_key(cold, 3072)]
+        self.assertLess(hot_entry.last_used, cold_entry.last_used)
+        self.assertGreater(hot_entry.value, cold_entry.value)
+        policy.observe(incoming, [4096], 0)
+        self.assertEqual(policy.observe(incoming, [4096], 0), [4096])
+        self.assertEqual(evicted, [3072])
+        self.assertTrue(hot_entry.reserved_bytes)
+        self.assertFalse(cold_entry.reserved_bytes)
+        self.assertEqual(policy.stats()["active"], 2)
+        self.assertEqual(policy.stats()["max_bytes"], 2 * 1024 ** 3)
+
