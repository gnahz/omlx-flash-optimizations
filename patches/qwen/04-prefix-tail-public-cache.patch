diff --git a/omlx/cache/public_prefix.py b/omlx/cache/public_prefix.py
new file mode 100644
index 00000000..1629a5c1
--- /dev/null
+++ b/omlx/cache/public_prefix.py
@@ -0,0 +1,165 @@
+"""Bounded admission for exact, tokenized initial system-message snapshots.
+
+This module never constructs or truncates recurrent state. Its positions are
+only requests to stop a real prefill and capture the state at that position.
+"""
+from __future__ import annotations
+
+from array import array
+from dataclasses import dataclass
+import hashlib
+import threading
+import time
+
+
+def initial_message_boundaries(tokens, tokenizer, *, minimum=256, maximum=32768):
+    """Find at most two complete initial system/developer token messages.
+
+    Match exact encoded headers and existing special-token IDs. No rendering a
+    different chat template, decoding/re-encoding content, or subtracting lengths.
+    A system turn containing tool definitions is captured as one common prefix.
+    """
+    encode = lambda text: list(tokenizer.encode(text, add_special_tokens=False))
+    try:
+        start = encode("<|im_start|>")
+        end = encode("<|im_end|>")
+        headers = [encode("<|im_start|>" + role + "\n")
+                   for role in ("system", "developer")]
+    except (AttributeError, TypeError, ValueError):
+        return []
+    if len(start) != 1 or len(end) != 1:
+        return []
+    result, position = [], 0
+    for _ in range(2):
+        header = next((h for h in headers if tokens[position:position+len(h)] == h), None)
+        if header is None:
+            break
+        try:
+            following = tokens.index(start[0], position + len(header))
+        except ValueError:
+            break
+        if end[0] not in tokens[position + len(header):following]:
+            break
+        if minimum <= following <= maximum:
+            result.append(following)
+        position = following
+    return result
+
+
+def prefix_key(tokens, length):
+    # Local process identifier only; the persisted block keeps oMLX's full
+    # model/parent/token/extra-key hash and compatibility signature.
+    return hashlib.sha256(array("I", tokens[:length]).tobytes()).hexdigest()
+
+
+@dataclass
+class Candidate:
+    length: int
+    opportunities: int = 0
+    covered: int = 0
+    direct_hits: int = 0
+    last_used: int = 0
+    reserved_bytes: int = 0
+    block_hash: bytes | None = None
+    admitted_at: float = 0
+
+    @property
+    def value(self):
+        return (self.direct_hits + 0.25 * self.covered) / max(1, self.opportunities)
+
+
+class PublicPrefixPolicy:
+    """Two-observation admission; hit-rate/LRU eviction under a byte budget.
+
+    Capacity reserves a conservative Qwen4 bound (128MiB recurrent state plus
+    32KiB per token in the partial KV block and 1MiB metadata). Reconciliation
+    raises reservations if observed durable bytes exceed that bound. The owner
+    supplies safe eviction: busy or pending-write branches cannot be evicted.
+    """
+    def __init__(self, block_size, *, max_bytes=2*1024**3, max_active=8,
+                 max_candidates=128, evict=lambda entry: True, size=lambda entry: 0):
+        self.block_size = block_size
+        self.max_bytes = max_bytes
+        self.max_active = max_active
+        self.max_candidates = max_candidates
+        self.evict = evict
+        self.size = size
+        self.entries = {}
+        self.serial = 0
+        self.admissions = self.evictions = self.deferred = 0
+        self.lock = threading.RLock()
+
+    def _cost(self, length):
+        return 129*1024**2 + (length % self.block_size)*32768
+
+    def _active(self):
+        return [e for e in self.entries.values() if e.reserved_bytes]
+
+    def _make_room(self, needed, *, protect):
+        active = self._active()
+        for entry in active:
+            entry.reserved_bytes = max(entry.reserved_bytes, self.size(entry))
+        victims = sorted((e for e in active if id(e) not in protect),
+                         key=lambda e: (e.value, e.last_used))
+        while (sum(e.reserved_bytes for e in self._active()) + needed > self.max_bytes
+               or (needed and len(self._active()) >= self.max_active)):
+            if not victims:
+                return False
+            victim = victims.pop(0)
+            if not self.evict(victim):
+                continue
+            victim.reserved_bytes = 0
+            victim.block_hash = None
+            self.evictions += 1
+        return True
+
+    def observe(self, tokens, boundaries, cached_tokens):
+        """Return admitted positions, including hits (caller skips cached ones)."""
+        with self.lock:
+            self.serial += 1
+            chosen, protected = [], set()
+            for position in boundaries[:2]:
+                if position <= 0 or position >= len(tokens) or position % self.block_size == 0:
+                    continue
+                key = prefix_key(tokens, position)
+                entry = self.entries.setdefault(key, Candidate(position))
+                entry.opportunities += 1
+                entry.last_used = self.serial
+                entry.covered += int(cached_tokens >= position)
+                entry.direct_hits += int(cached_tokens == position)
+                if entry.opportunities < 2:
+                    continue
+                cost = self._cost(position)
+                if not entry.reserved_bytes:
+                    if cost > self.max_bytes or not self._make_room(cost, protect=protected):
+                        self.deferred += 1
+                        continue
+                    entry.reserved_bytes = cost
+                    entry.admitted_at = time.monotonic()
+                    self.admissions += 1
+                protected.add(id(entry))
+                chosen.append(position)
+            self._make_room(0, protect=protected)
+            inactive = sorted(((k,e) for k,e in self.entries.items() if not e.reserved_bytes),
+                              key=lambda pair: (pair[1].value, pair[1].last_used))
+            while len(self.entries) > self.max_candidates and inactive:
+                self.entries.pop(inactive.pop(0)[0], None)
+            return chosen
+
+    def bind(self, tokens, block_hash):
+        with self.lock:
+            entry = self.entries.get(prefix_key(tokens, len(tokens)))
+            if entry is not None and entry.reserved_bytes:
+                entry.block_hash = block_hash
+                entry.reserved_bytes = max(entry.reserved_bytes, self.size(entry))
+
+    def stats(self):
+        with self.lock:
+            entries = list(self.entries.values())
+            return {"candidates": len(entries), "active": len(self._active()),
+                    "reserved_bytes": sum(e.reserved_bytes for e in entries),
+                    "max_bytes": self.max_bytes, "admissions": self.admissions,
+                    "evictions": self.evictions, "deferred": self.deferred,
+                    "opportunities": sum(e.opportunities for e in entries),
+                    "covered": sum(e.covered for e in entries),
+                    "direct_hits": sum(e.direct_hits for e in entries)}
