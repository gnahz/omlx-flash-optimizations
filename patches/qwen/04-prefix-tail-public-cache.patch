+"""Bounded, nonblocking admission waits for real pending prefix-tail snapshots."""
+
+import concurrent.futures
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+import omlx.scheduler as scheduler_module
+from omlx.scheduler import Scheduler, _BoundarySnapshotProvider, _InflightStoreInfo
+from omlx.request import Request, SamplingParams
+
+
+class NonblockingFuture(concurrent.futures.Future):
+    def result(self, timeout=None):
+        raise AssertionError("freshness admission must never block on Future.result")
+
+
+def setup_pending(*, prompt_len=7792, store_len=8192, tails=(7785,), block=8192):
+    scheduler = object.__new__(Scheduler)
+    scheduler.config = SimpleNamespace(paged_cache_block_size=block)
+    scheduler.block_aware_cache = object()
+    scheduler._gdn_split_active = lambda: True
+    scheduler._detect_boundary_snapshot_need = lambda: True
+    scheduler._cache_freshness_waits = {}
+    scheduler.running = {}
+    scheduler.prefilling = []
+    future = NonblockingFuture()
+    scheduler._inflight_store_futures = {"previous": future}
+    scheduler._inflight_store_info = {"previous": _InflightStoreInfo(
+        tokens=list(range(store_len)), tail_snapshot_token_counts=tails,
+    )}
+    request = SimpleNamespace(
+        request_id="next", prompt_token_ids=list(range(prompt_len)),
+        vlm_extra_keys_for_cache=None, vlm_extra_key_token_start_for_cache=None,
+        vlm_extra_key_ranges_for_cache=None,
+    )
+    return scheduler, request, future
+
+
+def test_repeated_7792_prompt_waits_for_actual_7785_tail_without_blocking():
+    scheduler, request, future = setup_pending()
+    assert scheduler._should_defer_for_cache_freshness(request)
+    wait = scheduler._cache_freshness_waits[request.request_id]
+    assert wait.future is future and wait.store_request_id == "previous"
+    future.set_result(None)
+    assert not scheduler._should_defer_for_cache_freshness(request)
+    assert not scheduler._cache_freshness_waits
+
+
+@pytest.mark.parametrize("tails,expected", [
+    ((), False),                     # Equal text alone is not a checkpoint.
+    ((7792,), False),                # Cannot trim exact GDN state to N - 1.
+    ((7785, 7792), True),            # An earlier true endpoint permits kickoff.
+    ((100, 200), False),             # Insufficient useful overlap, despite equal text.
+    ((8000,), False),                # Snapshot is past the requested prefix.
+])
+def test_requires_real_reusable_gdn_endpoint(tails, expected):
+    scheduler, request, _ = setup_pending(tails=tails)
+    assert scheduler._should_defer_for_cache_freshness(request) is expected
+
+
+def test_changed_token_before_tail_does_not_wait_for_unrelated_snapshot():
+    scheduler, request, _ = setup_pending()
+    request.prompt_token_ids[2500] = -1
+    assert not scheduler._should_defer_for_cache_freshness(request)
+    assert not scheduler._cache_freshness_waits
+
+
+def test_only_matching_public_endpoint_of_multiple_tails_is_waited_for():
+    scheduler, request, _ = setup_pending(tails=(1000, 2572, 7785))
+    request.prompt_token_ids[2600] = -1
+    assert scheduler._should_defer_for_cache_freshness(request)
+    assert scheduler._cache_freshness_waits[request.request_id].common_prefix == 2600
+    scheduler._cache_freshness_waits.clear()
+    # There was no GDN checkpoint at 2572 in this alternate store. It is not
+    # valid to substitute the 7785 state or manufacture an endpoint at 2600.
+    scheduler._inflight_store_info["previous"].tail_snapshot_token_counts = (1000, 7785)
+    assert not scheduler._should_defer_for_cache_freshness(request)
+
+
+def test_cache_key_mismatch_and_finished_future_are_not_waited_for():
+    scheduler, request, future = setup_pending()
+    request.vlm_extra_keys_for_cache = ("different-image",)
+    assert not scheduler._should_defer_for_cache_freshness(request)
+    request.vlm_extra_keys_for_cache = None
+    future.set_result(None)
+    assert not scheduler._should_defer_for_cache_freshness(request)
+
+
+def test_timeout_uses_original_four_second_limit(monkeypatch):
+    scheduler, request, _ = setup_pending()
+    current = [10.0]
+    monkeypatch.setattr(scheduler_module.time, "monotonic", lambda: current[0])
+    assert scheduler._should_defer_for_cache_freshness(request)
+    assert scheduler._cache_freshness_waits[request.request_id].deadline_s == 14.0
+    current[0] = 13.999
+    assert scheduler._should_defer_for_cache_freshness(request)
+    current[0] = 14.0
+    assert not scheduler._should_defer_for_cache_freshness(request)
+    assert not scheduler._cache_freshness_waits
+
+
+@pytest.mark.parametrize("cancel", [False, True])
+def test_failed_or_cancelled_store_releases_wait(cancel):
+    scheduler, request, future = setup_pending()
+    assert scheduler._should_defer_for_cache_freshness(request)
+    if cancel:
+        future.cancel()
+    else:
+        future.set_exception(RuntimeError("storage failed"))
+    assert not scheduler._should_defer_for_cache_freshness(request)
+    assert not scheduler._cache_freshness_waits
+
+
+def test_store_size_limit_still_rejects_waiting_for_huge_unrelated_remainder():
+    scheduler, request, _ = setup_pending(store_len=16 * 7785 + 1)
+    assert not scheduler._should_defer_for_cache_freshness(request)
+
+
+def test_prompt_tail_metadata_includes_terminal_and_auxiliary_true_snapshots():
+    provider = _BoundarySnapshotProvider(
+        None, "previous", [8192], {}, tail_terminal_token_count=9000,
+        auxiliary_tails={7785: [{"state": ()}], 2500: [{"state": ()}]},
+    )
+    assert provider.pending_tail_snapshot_counts() == (2500, 7785, 9000)
+    # Ordinary full block endpoints are still handled by the original path.
+    assert 8192 not in provider.pending_tail_snapshot_counts()
+    info = _InflightStoreInfo(tokens=list(range(9000)), tail_snapshot_token_counts=provider.pending_tail_snapshot_counts())
+    assert info.tail_snapshot_token_counts == (2500, 7785, 9000)
+
+
+def test_existing_short_terminal_tail_uses_same_pending_future():
+    scheduler, request, future = setup_pending(prompt_len=193, store_len=186, tails=(186,))
+    assert scheduler._should_defer_for_cache_freshness(request)
+    assert scheduler._cache_freshness_waits[request.request_id].future is future
+
+
+def test_nonmatching_pending_request_does_not_inherit_another_request_wait():
+    scheduler, request, _ = setup_pending()
+    assert scheduler._should_defer_for_cache_freshness(request)
+    unrelated = SimpleNamespace(**vars(request))
+    unrelated.request_id = "unrelated"
+    unrelated.prompt_token_ids = [-1, -2, -3]
+    assert not scheduler._should_defer_for_cache_freshness(unrelated)
+    assert set(scheduler._cache_freshness_waits) == {"next"}
+
+
+def test_submission_registers_the_same_snapshot_future_and_materializes_tails(
+    mock_model, mock_tokenizer, monkeypatch,
+):
+    """The real cleanup handoff advertises only the tails owned by its worker."""
+    import mlx.core as mx
+
+    scheduler = Scheduler(model=mock_model, tokenizer=mock_tokenizer)
+    scheduler.block_aware_cache = MagicMock()
+    scheduler.paged_cache_manager = None
+    scheduler._store_cache_executor = MagicMock()
+    future = NonblockingFuture()
+    scheduler._store_cache_executor.submit.return_value = future
+    main_array = mx.zeros((1,), stream=mx.cpu)
+    tail_arrays = [mx.full((1,), float(tc), stream=mx.cpu) for tc in (3, 7, 11)]
+    main_cache = [{"state": (main_array,), "cache_type": "ArraysCache"}]
+    provider = _BoundarySnapshotProvider(
+        None, "previous", [], {}, auxiliary_tails={
+            tc: [{"state": (array,), "cache_type": "ArraysCache"}]
+            for tc, array in zip((3, 7, 11), tail_arrays)
+        },
+    )
+    request = Request(request_id="previous", prompt="text", sampling_params=SamplingParams())
+    request.prompt_token_ids = list(range(11))
+    request.num_prompt_tokens = 11
+    request.output_token_ids = list(range(11, 14))
+    request._extracted_cache = main_cache
+    request._model_cache_config = None
+    scheduler.requests[request.request_id] = request
+    scheduler.running[request.request_id] = request
+    monkeypatch.setattr(scheduler, "_get_boundary_store_override", lambda *_: (
+        list(range(12)), main_cache, None, provider,
+    ))
+    monkeypatch.setattr(scheduler_module, "_safe_sync_stream", lambda *_: None)
+    evaluated = MagicMock()
+    monkeypatch.setattr(scheduler_module.mx, "eval", evaluated)
+    scheduler._cleanup_finished({request.request_id})
+
+    assert scheduler._inflight_store_futures[request.request_id] is future
+    assert scheduler._inflight_store_info[request.request_id].tail_snapshot_token_counts == (3, 7, 11)
+    assert scheduler._store_cache_executor.submit.call_args.args[5] is provider
+    evaluated.assert_called_once()
+    assert evaluated.call_args.args == (main_array, *tail_arrays)
