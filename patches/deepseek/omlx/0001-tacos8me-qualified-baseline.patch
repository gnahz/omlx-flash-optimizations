+
+
+def _attentions(model):
+    for i, layer in enumerate(getattr(model, "layers", [])):
+        if hasattr(layer, "attn"):
+            yield f"layers.{i}", layer.attn
+    for i, stage in enumerate(getattr(model, "mtp", None) or []):
+        yield f"mtp.{i}", stage.attn
