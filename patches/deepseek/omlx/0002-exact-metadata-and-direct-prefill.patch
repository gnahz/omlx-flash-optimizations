+#!/usr/bin/env python3
+"""Flatten pinned MLX Metal headers for runtime compilation without MLX imports.
+
+The canonical Metal shader remains reviewable. Regenerate this vendored header
+when that shader changes; MLX core itself is neither edited nor rebuilt.
+"""
+import argparse
+import hashlib
+from pathlib import Path
+import re
+
+
+def render(mlx_source: Path):
+    csrc = Path(__file__).resolve().parent
+    paths, seen = [], set()
+
+    def expand(path: Path):
+        path = path.resolve()
+        if path in seen:
+            return ""
+        seen.add(path)
+        raw = path.read_text()
+        relative = (path.relative_to(mlx_source).as_posix()
+                    if path.is_relative_to(mlx_source) else path.name)
+        paths.append((relative, hashlib.sha256(raw.encode()).hexdigest()))
+        raw = re.sub(r"^#pragma once\s*$", "", raw, flags=re.M)
+
+        def include(match):
+            target = match.group(1)
+            dependency = (mlx_source / target if target.startswith("mlx/")
+                          else path.parent / target)
+            return expand(dependency)
+
+        return re.sub(r'^#include "([^"]+)"\s*$', include, raw, flags=re.M)
+
+    body = expand(csrc / "deepseek_v41_joint_metadata.metal")
+    assert ')DS41JM"' not in body
+    pins = "\n".join(f"// source-sha256 {digest} {path}" for path, digest in paths)
+    return ('// Generated by generate_deepseek_v41_joint_metadata_jit.py.\n'
+            '// Apple MLX portions retain MIT copyright and license. See MLX_LICENSE.txt.\n'
+            + pins + '\n#pragma once\n#include <string>\n'
+            'inline std::string omlx_ds41_joint_metadata_nax_source() {\n'
+            'return R"DS41JM(\n' + body + '\n)DS41JM";\n}\n')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--mlx-source", type=Path, required=True)
+    parser.add_argument("--check", action="store_true",
+                        help="Assert the tracked JIT header matches canonical inputs; do not write")
+    args = parser.parse_args()
+    mlx_source = args.mlx_source.expanduser().resolve()
+    output = Path(__file__).resolve().with_name("deepseek_v41_joint_metadata_jit_source.h")
+    body = render(mlx_source)
+    if args.check:
+        if output.read_text() != body:
+            raise SystemExit("The joint-metadata JIT header must be regenerated")
+    else:
+        output.write_text(body)
+    print(f"joint-metadata JIT source: {len(body)} bytes")
+
+
+if __name__ == "__main__":
+    main()
